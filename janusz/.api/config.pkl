amends "modulepath:/api/ApiConfig.pkl"

org = "bryzek"

local tsSrc = "./src/generated"

// platform's spec/thesis.json: the questions page posts one submission per answered question.
// platform-error carries the validation_error a 422 or a 429 answers.
applications = new Listing<AppGroup> {
  new { names { "thesis" };         generators = module.singleGenerator("typescript", tsSrc) }
  new { names { "platform-error" }; generators = module.singleGenerator("typescript", tsSrc) }
}
